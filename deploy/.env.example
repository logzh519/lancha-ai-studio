# 复制为 .env 供 docker compose 读取
POSTGRES_USER=lancha
POSTGRES_PASSWORD=lancha
POSTGRES_DB=lancha_ai_studio
POSTGRES_PORT=5432

# 生产默认走飞书认证；本地开发可在 deploy/.env 显式设置 AUTH_MODE=dev_header
AUTH_MODE=feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
COOKIE_SECURE=true
FRONTEND_BASE_URL=http://localhost:8080

# 后端启用的模块、前端打包的模块，均为空表示全部
ENABLED_MODULES=
VITE_ENABLED_MODULES=
