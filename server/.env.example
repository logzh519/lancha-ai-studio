# 复制为 .env 后按需修改；.env 不进版本库
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 前端开发地址，逗号分隔；为空则不开启跨域
CORS_ORIGINS=http://localhost:5173

# 启用的模块（modules/ 下的目录名），逗号分隔；为空表示全部加载
# 本地只开发自己的模块时，在这里只写自己的模块名，启动更快也不会被别人的代码阻塞
ENABLED_MODULES=

# 认证方式：dev_header 用 X-User-Id 请求头模拟身份（仅限本地开发，等于无认证），feishu 走飞书扫码登录。
# 做成显式开关而不是「配了 app_id 就启用」：漏配时静默退回无认证，在生产上没人会发现。
AUTH_MODE=dev_header

# 飞书应用凭证，AUTH_MODE=feishu 时三项必填（缺一项启动即报错）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书会把浏览器直接重定向到这里，开发期必须填前端地址（经 Vite 代理转发到后端），
# 填后端地址会让 cookie 落在后端域下，前端带不过去，表现为「回调成功但仍未登录」。
# 同一个地址还要原样登记到飞书开放平台的「重定向 URL」里。
FEISHU_REDIRECT_URI=http://localhost:5173/api/auth/feishu/callback
FEISHU_SCOPE=auth:user.id:read contact:user.employee:readonly

# 会话有效期（天）；生产环境走 HTTPS 时把 COOKIE_SECURE 置为 true，否则 cookie 会明文传输
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
# 回调完成后浏览器跳回的前端地址
FRONTEND_BASE_URL=http://localhost:5173

# 用 127.0.0.1 而非 localhost：Windows 上 localhost 优先解析为 ::1，Docker 端口转发不通会卡住
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=lancha
POSTGRES_PASSWORD=lancha
POSTGRES_DB=lancha_ai_studio

# LLM：阿里百炼
ALI_API_KEY=
ALI_OPENAI_BASE_URL=https://ws-gx6i1hxncyjd07yu.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALI_ANTHROPIC_BASE_URL=https://ws-gx6i1hxncyjd07yu.cn-beijing.maas.aliyuncs.com/apps/anthropic
ALI_TEST_LLM_MODEL=deepseek-v4.1-flash
# LLM：朗驰中转（仅 OpenAI 兼容）
LCH_API_KEY=
LCH_OPENAI_BASE_URL=https://ai.gwroute.site
LCH_LLM_MODEL=gpt-5.6-sol
LCH_IMAGE_MODEL=gpt-image-2

# 默认对象存储服务：tos / obs，留空则使用 tos
STORAGE_PROVIDER=
# 火山引擎 TOS
TOS_BUCKET_NAME=
TOS_REGION=cn-beijing
TOS_DEFAULT_ACL=private
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
# 华为云 OBS（endpoint 须与 bucket 所在区域一致）
OBS_BUCKET_NAME=
OBS_DEFAULT_ACL=private
OBS_ENDPOINT=obs.cn-south-1.myhuaweicloud.com
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=

# 模块自己的配置用 <模块名大写>_ 前缀
EXAMPLE_PAGE_SIZE=20
