# 复制为 .env 后按需修改；.env 不进版本库
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 前端开发地址，逗号分隔；为空则不开启跨域
CORS_ORIGINS=http://localhost:5173

# 启用的模块（modules/ 下的目录名），逗号分隔；为空表示全部加载
# 本地只开发自己的模块时，在这里只写自己的模块名，启动更快也不会被别人的代码阻塞
ENABLED_MODULES=

# 用 127.0.0.1 而非 localhost：Windows 上 localhost 优先解析为 ::1，Docker 端口转发不通会卡住
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=lancha
POSTGRES_PASSWORD=lancha
POSTGRES_DB=lancha_ai_studio

# 模块自己的配置用 <模块名大写>_ 前缀
EXAMPLE_PAGE_SIZE=20
